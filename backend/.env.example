# Copy to backend/.env and fill in. Never commit the real .env.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any chat model ID enabled for your key. List them with:
#   GET http://localhost:8000/api/health  (shows availability + alternatives)
# or https://console.groq.com/docs/models . Model IDs change over time;
# the example below was valid when this project was written.
GROQ_MODEL=llama-3.3-70b-versatile

# Context management (estimated tokens). Set MODEL_CONTEXT_WINDOW to your model's
# real limit (or lower to save quota). Budgets must fit inside it.
MODEL_CONTEXT_WINDOW=8192
MAX_RESPONSE_TOKENS=1024
HISTORY_TOKEN_BUDGET=3000
RAG_TOKEN_BUDGET=2000
RECENT_MESSAGES_TO_KEEP=6

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30

# Uploads
MAX_UPLOAD_MB=15
# Optional: full path to tesseract.exe if it is not on PATH
TESSERACT_CMD=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
